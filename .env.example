# GitHub API Token (for fetching repositories)
GITHUB_TOKEN=your_github_personal_access_token_here

# Email Configuration (for contact form)
RESEND_API_KEY=re_your_resend_api_key_here
# Must be a verified sender/domain in Resend, e.g. "Dan Spelt <[email protected]>"
RESEND_FROM=Dan Spelt <noreply@danspelt.com>
CONTACT_TO_EMAIL=danspelt24@gmail.com

# OpenAI API (if using AI features)
OPENAI_API_KEY=your_openai_api_key_here

# AI assistant switch. Off unless set to exactly "true", so a missing or revoked
# OPENAI_API_KEY shows visitors an explanation instead of an error.
# Read at build time: in Coolify, enable "Available at Buildtime" on this variable.
NEXT_PUBLIC_AI_CHAT_ENABLED=false

# Azure Speech Services (if using speech features)
SPEECH_KEY=your_azure_speech_key_here
SPEECH_REGION=your_azure_region_here

# Qdrant Vector Database (if using vector search)
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
